#include <Servo.h> // servo library
Servo waterDirectionServo; 
int sensorValue1=0;
int sensorValue2=0;
int pos = 0; 

void setup()
 {
 // put your setup code here, to run once:
pinMode(A0, INPUT_PULLUP);           // Soil Moisture Sensor 1 PIN A0
pinMode(A1, INPUT_PULLUP);           // Soil Moisture Sensor 1 PIN A1
pinMode(8,OUTPUT);                   // Relay Module PIN D8
Serial.begin(9600);                  //  Sensor Buart Rate
waterDirectionServo.attach(9);       //  Servo PIN D9
digitalWrite(8, HIGH);               // Relay Normally Hight for OFF condition
}  

void loop() 
{
// put your main code here, to run repeatedly:
int sensorValue1= analogRead(A0);                         // Soil Moisture Sensor 1 PIN A0
int sensorValue2= analogRead(A1);                         // Soil Moisture Sensor 1 PIN A1
Serial.println(sensorValue1);
delay(10);
Serial.println(sensorValue2);
delay(200);

if (sensorValue1>=980)
{
waterDirectionServo.write(90);                           // tell servo to go to position in variable 'pos'
digitalWrite(8, LOW);                                    // Relay ON
delay(1000);
}

else if(sensorValue1<=970) 
{
digitalWrite(8, HIGH);                                 // Relay ON
}

if (sensorValue2>=980)
{
waterDirectionServo.write(0);                         // tell servo to go to position in variable 'pos'
digitalWrite(8, LOW);                                 // Relay ON
delay(1000);
}

else if(sensorValue2<=970)
{
digitalWrite(8, HIGH);                                // Relay OFF
}
  
else
{
digitalWrite(8, HIGH);   // Relay OFF
}
}

